import { Button, ListView, Palette } from "std-widgets.slint";
import { Cell, GridRow, VolumeEntry, KnownEntry, MenuEntry, SourceEntry, Texts, Editing, Task } from "common.slint";
import { ImportDialog } from "import.slint";
import { WelcomeView } from "welcome.slint";
import { NewWorkspaceDialog, SettingsDialog, AboutDialog, AddSourceDialog, RemoveSourceDialog, RestoreDialog } from "dialogs.slint";
import { CataloguePanel } from "catalogue.slint";
import { MenuOverlay } from "menu.slint";

export { Cell, GridRow, VolumeEntry, KnownEntry, MenuEntry, SourceEntry, Texts, Editing }

export component MainWindow inherits Window {
    property <string> app-name: @tr("Auroraw");
    title: root.workspace-name == "" ? root.app-name : root.workspace-name + " — " + root.app-name;
    background: #1e1e1e;
    preferred-width: 1400px;
    preferred-height: 900px;
    min-width: 640px;
    min-height: 420px;
    init => { Palette.color-scheme = ColorScheme.dark; }

    in property <[GridRow]> rows;
    in property <string> status;
    in property <int> min-rating-filter: 0;
    in property <string> selected-summary;
    in-out property <length> grid-scroll: 0px;
    // The grid fills the window's width (less the scroll bar) and the height that the top bar, the
    // filter bar and the status strip leave; a cell is 160 wide and a row 124 high (see the grid
    // below). Rust re-flows the rows when the count changes and reads the rows and the height to
    // page and to keep the selection in view.
    out property <int> grid-columns: max(1, floor((root.width - 20px + 4px) / 164px));
    out property <length> grid-view-height: max(124px, root.height - 100px);
    out property <int> grid-visible-rows: max(1, floor(root.grid-view-height / 124px));
    changed grid-columns => { root.columns-changed(root.grid-columns); }
    in-out property <string> current-task: "cull";
    // "welcome" (no workspace open) or "workspace".
    in property <string> screen: "welcome";
    in property <string> workspace-name;
    in property <[KnownEntry]> known;
    in property <string> welcome-note;
    // The dialog over the window: "" or "new-workspace".
    in-out property <string> dialog;
    in-out property <string> new-name;
    in-out property <string> new-location;
    in property <string> new-preview;
    in property <string> dialog-error;
    // A message over the window (a workspace that could not be opened, a card that was inserted).
    in-out property <string> notice;
    in-out property <bool> menu-open: false;
    // "system", "en" or "fr" (Settings).
    in property <string> language: "system";
    // A card that was just inserted: "Card detected: ..." with a way to import from it.
    in property <string> card-banner;
    in property <string> about-version;
    // The catalogue panel: the sources, what a scan is doing, and the dialogs over it.
    in property <[SourceEntry]> sources;
    in property <string> catalogue-status;
    in property <float> catalogue-progress;
    in property <bool> catalogue-busy;
    in-out property <string> source-folder;
    in-out property <string> source-name;
    in property <string> add-source-error;
    in property <string> add-source-merge-question;
    in property <string> remove-name;
    in property <int> remove-photos;
    in property <int> remove-worked-on;
    in property <int> restore-count;
    in property <int> restore-total;
    in property <string> modifier-name: "Ctrl";
    in property <string> redo-shortcut: "Ctrl+Y";

    in property <[VolumeEntry]> volumes;
    in property <string> import-status;
    in property <float> import-progress;
    in property <bool> importing;
    in property <bool> import-finished;
    // A folder dialog is open: the browse buttons wait for it.
    in property <bool> picking;
    in property <string> import-destination-kind;
    in property <string> import-destination-note;
    in property <bool> import-source-has-folders;
    in property <string> import-source-folders;
    in property <bool> import-registering;
    in-out property <string> import-layout: "template";
    in-out property <bool> import-add-destination: true;
    in-out property <string> import-source;
    in-out property <string> import-destination;
    in-out property <string> import-backup;
    in-out property <string> import-template;
    in-out property <string> import-shoot;
    in-out property <string> import-creator;
    in-out property <string> import-rights;

    callback cell-clicked(int);
    callback rate-selected(string);
    callback move-selection(int, int);
    // "page-up", "page-down", "home" or "end".
    callback jump-selection(string);
    callback columns-changed(int);
    callback set-filter(int);
    callback start-import();
    callback cancel-import();
    callback refresh-volumes();
    callback show-photos();
    callback import-fields-changed();
    callback card-import();
    callback card-dismiss();
    callback browse-folder(string);
    callback new-workspace();
    callback open-workspace();
    callback open-known(int);
    callback forget-known(int);
    callback create-workspace();
    callback close-dialog();
    callback new-name-edited(string);
    callback new-location-edited(string);
    callback dismiss-notice();
    // Every action of the menus and their shortcuts, by the id of `commands.rs`.
    callback command(string);
    callback language-chosen(string);
    callback add-source();
    callback add-source-confirm();
    callback add-source-merge();
    callback remove-source(int);
    callback remove-source-confirm();
    callback rescan-source(int);
    callback restore-choice(bool);
    callback restore-cancelled();

    scope := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape && root.menu-open) {
                root.menu-open = false;
                return accept;
            }
            if (event.text == Key.F1) {
                root.command("help.about");
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == "n") { root.command("file.new-workspace"); return accept; }
                if (event.text == "o") { root.command("file.open-workspace"); return accept; }
                if (event.text == ",") { root.command("file.settings"); return accept; }
                if (event.text == "i") { root.command("file.import"); return accept; }
                if (event.text == "q") { root.command("file.quit"); return accept; }
            }
            reject
        }
        VerticalLayout {
            // The top bar: the menu, and, once a workspace is open, the task bar (spec §3:
            // "workflows, not panels"). Import and Cull have a view so far; Develop and Publish
            // come with later milestones.
            Rectangle {
                height: 36px;
                background: #262626;
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        width: 44px;
                        background: menu-touch.has-hover || root.menu-open ? #3a3a3a : transparent;
                        accessible-role: button;
                        accessible-label: @tr("Menu");
                        accessible-action-default => { root.menu-open = !root.menu-open; }
                        menu-touch := TouchArea { clicked => { root.menu-open = !root.menu-open; } }
                        Text {
                            text: "☰";
                            color: white;
                            font-size: 18px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    if root.screen == "workspace" : Task { label: @tr("Catalogue"); active: root.current-task == "catalogue"; activate => { root.current-task = "catalogue"; } }
                    if root.screen == "workspace" : Task { label: @tr("Cull"); active: root.current-task == "cull"; activate => { root.show-photos(); } }
                    if root.screen == "workspace" : Task { label: @tr("Develop"); enabled: false; }
                    if root.screen == "workspace" : Task { label: @tr("Publish"); enabled: false; }
                }
            }

            if root.screen == "welcome" : WelcomeView {
                known: root.known;
                note: root.welcome-note;
                new-workspace => { root.new-workspace(); }
                open-workspace => { root.open-workspace(); }
                open-known(i) => { root.open-known(i); }
                forget-known(i) => { root.forget-known(i); }
            }

            if root.screen == "workspace" : VerticalLayout {
            if root.current-task == "catalogue" : CataloguePanel {
                sources: root.sources;
                status: root.catalogue-status;
                progress: root.catalogue-progress;
                busy: root.catalogue-busy;
                add-source => { root.add-source(); }
                remove-source(i) => { root.remove-source(i); }
                rescan-source(i) => { root.rescan-source(i); }
            }

            if root.current-task == "cull" : VerticalLayout {
                // The filter bar and status line.
                Rectangle {
                    height: 36px;
                    background: #2b2b2b;
                    HorizontalLayout {
                        padding: 6px;
                        spacing: 6px;
                        alignment: start;
                        Button { text: @tr("All"); clicked => { root.set-filter(0); } }
                        Button { text: @tr("1+"); clicked => { root.set-filter(1); } }
                        Button { text: @tr("2+"); clicked => { root.set-filter(2); } }
                        Button { text: @tr("3+"); clicked => { root.set-filter(3); } }
                        Button { text: @tr("4+"); clicked => { root.set-filter(4); } }
                        Button { text: @tr("5"); clicked => { root.set-filter(5); } }
                        Text {
                            text: root.status;
                            color: #99cc99;
                            vertical-alignment: center;
                        }
                    }
                }

                // The library grid.
                grid-focus := FocusScope {
                    init => { self.focus(); }
                    key-pressed(event) => {
                        if (event.text == "0" || event.text == "1" || event.text == "2" || event.text == "3" || event.text == "4" || event.text == "5") {
                            root.rate-selected(event.text);
                            return accept;
                        }
                        if (event.text == Key.UpArrow) { root.move-selection(0, -1); return accept; }
                        if (event.text == Key.DownArrow) { root.move-selection(0, 1); return accept; }
                        if (event.text == Key.LeftArrow) { root.move-selection(-1, 0); return accept; }
                        if (event.text == Key.RightArrow) { root.move-selection(1, 0); return accept; }
                        if (event.text == Key.PageUp) { root.jump-selection("page-up"); return accept; }
                        if (event.text == Key.PageDown) { root.jump-selection("page-down"); return accept; }
                        if (event.text == Key.Home) { root.jump-selection("home"); return accept; }
                        if (event.text == Key.End) { root.jump-selection("end"); return accept; }
                        reject
                    }
                    ListView {
                        content-y <=> root.grid-scroll;
                        for row[ri] in root.rows : HorizontalLayout {
                            height: 124px;
                            spacing: 4px;
                            padding-left: 4px;
                            alignment: start;
                            for c[ci] in row.cells : Rectangle {
                                width: 160px;
                                height: 120px;
                                background: #333333;
                                border-width: c.selected ? 2px : 0px;
                                border-color: #ffd24a;
                                TouchArea {
                                    clicked => {
                                        grid-focus.focus();
                                        root.cell-clicked(c.index);
                                    }
                                }
                                if c.ready : Image {
                                    source: c.thumb;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                    accessible-role: image;
                                    accessible-label: c.rating > 0 ? @tr("Photo, {} stars", c.rating) : @tr("Photo");
                                }
                                if c.unavailable : Text {
                                    text: @tr("No preview");
                                    color: #888888;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                    accessible-role: text;
                                }
                                if c.rating > 0 : Text {
                                    x: 6px;
                                    y: 4px;
                                    text: "\{c.rating}★";
                                    color: #ffd24a;
                                }
                            }
                        }
                    }
                }

                // A status strip for the selected photo (a minimal metadata panel, WP8's own scope
                // note: filters, collections, keywords are grown in a later pass).
                Rectangle {
                    height: 28px;
                    background: #262626;
                    Text {
                        text: root.selected-summary;
                        color: #cccccc;
                        x: 6px;
                        vertical-alignment: center;
                        height: 100%;
                    }
                }
            }
            }
        }
    }

    if root.dialog == "import" : ImportDialog {
        x: 0px;
        y: 36px;
        width: root.width;
        height: root.height - 36px;
        volumes: root.volumes;
        status: root.import-status;
        progress: root.import-progress;
        importing: root.importing;
        finished: root.import-finished;
        picking: root.picking;
        destination-kind: root.import-destination-kind;
        destination-note: root.import-destination-note;
        source-has-folders: root.import-source-has-folders;
        source-folders: root.import-source-folders;
        registering: root.import-registering;
        source <=> root.import-source;
        destination <=> root.import-destination;
        backup <=> root.import-backup;
        template <=> root.import-template;
        shoot <=> root.import-shoot;
        creator <=> root.import-creator;
        rights <=> root.import-rights;
        layout <=> root.import-layout;
        add-destination <=> root.import-add-destination;
        close => { root.close-dialog(); }
        start-import => { root.start-import(); }
        cancel-import => { root.cancel-import(); }
        refresh-volumes => { root.refresh-volumes(); }
        show-photos => { root.show-photos(); }
        browse-folder(which) => { root.browse-folder(which); }
        fields-changed => { root.import-fields-changed(); }
    }
    if root.dialog == "add-source" : AddSourceDialog {
        x: 0px;
        y: 36px;
        width: root.width;
        height: root.height - 36px;
        error: root.add-source-error;
        merge-question: root.add-source-merge-question;
        browse-enabled: !root.picking;
        folder <=> root.source-folder;
        name <=> root.source-name;
        close => { root.close-dialog(); }
        confirm => { root.add-source-confirm(); }
        merge => { root.add-source-merge(); }
        browse => { root.browse-folder("add-source"); }
    }
    if root.dialog == "remove-source" : RemoveSourceDialog {
        x: 0px;
        y: 36px;
        width: root.width;
        height: root.height - 36px;
        source-name: root.remove-name;
        photos: root.remove-photos;
        worked-on: root.remove-worked-on;
        close => { root.close-dialog(); }
        confirm => { root.remove-source-confirm(); }
    }
    if root.dialog == "restore" : RestoreDialog {
        x: 0px;
        y: 36px;
        width: root.width;
        height: root.height - 36px;
        restorable: root.restore-count;
        total: root.restore-total;
        close => { root.restore-cancelled(); }
        choose(restore) => { root.restore-choice(restore); }
    }
    if root.dialog == "settings" : SettingsDialog {
        x: 0px;
        y: 36px;
        width: root.width;
        height: root.height - 36px;
        language: root.language;
        close => { root.close-dialog(); }
        language-chosen(code) => { root.language-chosen(code); }
    }
    if root.dialog == "about" : AboutDialog {
        x: 0px;
        y: 36px;
        width: root.width;
        height: root.height - 36px;
        version: root.about-version;
        close => { root.close-dialog(); }
    }
    if root.dialog == "new-workspace" : NewWorkspaceDialog {
        x: 0px;
        y: 36px;
        width: root.width;
        height: root.height - 36px;
        error: root.dialog-error;
        browse-enabled: !root.picking;
        preview: root.new-preview;
        name <=> root.new-name;
        location <=> root.new-location;
        close => { root.close-dialog(); }
        create => { root.create-workspace(); }
        browse => { root.browse-folder("workspace"); }
        name-edited(text) => { root.new-name-edited(text); }
        location-edited(text) => { root.new-location-edited(text); }
    }

    if root.menu-open : MenuOverlay {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        has-workspace: root.screen == "workspace";
        modifier: root.modifier-name;
        redo-shortcut: root.redo-shortcut;
        close => { root.menu-open = false; }
        command(id) => { root.command(id); }
    }
    if root.notice != "" : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: 40px;
        background: #4a3f1e;
        border-color: #7a6a30;
        border-width: 1px;
        HorizontalLayout {
            padding: 6px;
            spacing: 8px;
            Text {
                text: root.notice;
                color: white;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: text;
            }
            Button {
                text: @tr("Dismiss");
                clicked => { root.dismiss-notice(); }
            }
        }
    }

    if root.card-banner != "" : Rectangle {
        x: 0px;
        y: 40px;
        width: root.width;
        height: 40px;
        background: #1e3f4a;
        border-color: #307a8a;
        border-width: 1px;
        HorizontalLayout {
            padding: 6px;
            spacing: 8px;
            Text {
                text: root.card-banner;
                color: white;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: text;
            }
            Button { text: @tr("Import…"); primary: true; clicked => { root.card-import(); } }
            Button { text: @tr("Ignore"); clicked => { root.card-dismiss(); } }
        }
    }
}
