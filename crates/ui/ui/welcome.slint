import { Button, ListView } from "std-widgets.slint";
import { KnownEntry } from "common.slint";

// What opens when no workspace is: the ones this machine knows, and the two ways to get another.
export component WelcomeView inherits Rectangle {
    in property <[KnownEntry]> known;
    in property <string> note;
    callback new-workspace();
    callback open-workspace();
    callback open-known(int);
    callback forget-known(int);
    background: #1e1e1e;
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            // As wide as the window allows, up to 720px, centred (a width tied to the window's own
            // would loop through the window's layout constraints now that it can be resized).
            horizontal-stretch: 1;
            max-width: 720px;
            padding: 32px;
            spacing: 14px;
            alignment: start;
            Text {
                text: @tr("Welcome to Auroraw");
                color: white;
                font-size: 24px;
                font-weight: 700;
                accessible-role: text;
            }
            Text {
                text: @tr("Open a workspace, or create a new one.");
                color: #aaaaaa;
            }
            if root.note != "" : Text {
                text: root.note;
                color: #e0b050;
                wrap: word-wrap;
                accessible-role: text;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button { text: @tr("New workspace…"); primary: true; clicked => { root.new-workspace(); } }
                Button { text: @tr("Open workspace…"); clicked => { root.open-workspace(); } }
            }
            Text {
                text: root.known.length > 0 ? @tr("Recent workspaces") : @tr("No workspace yet.");
                color: #cccccc;
                font-weight: 700;
            }
            ListView {
                height: min(root.known.length * 60px, 380px);
                for entry[i] in root.known : Rectangle {
                    height: 56px;
                    background: touch.has-hover ? #333333 : #262626;
                    accessible-role: button;
                    accessible-label: entry.name + ", " + entry.path;
                    accessible-action-default => { root.open-known(i); }
                    touch := TouchArea { clicked => { root.open-known(i); } }
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 6px;
                        Text { text: entry.name; color: white; font-weight: 700; overflow: elide; }
                        Text { text: entry.path; color: #999999; overflow: elide; }
                    }
                    HorizontalLayout {
                        alignment: end;
                        padding-right: 12px;
                        spacing: 8px;
                        if !entry.found : Text {
                            text: @tr("Not found");
                            color: #e08070;
                            vertical-alignment: center;
                        }
                        if !entry.found : Button {
                            text: @tr("Remove from the list");
                            accessible-label: @tr("Remove from the list: {}", entry.name);
                            clicked => { root.forget-known(i); }
                        }
                        if entry.found : Text {
                            text: entry.opened;
                            color: #888888;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
