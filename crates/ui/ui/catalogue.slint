import { Button, ListView, ProgressIndicator } from "std-widgets.slint";
import { SourceEntry } from "common.slint";

// The catalogue's sources: the folders whose photos are in it. Adding one copies nothing.
export component CataloguePanel inherits Rectangle {
    in property <[SourceEntry]> sources;
    in property <string> status;
    in property <float> progress;
    in property <bool> busy;
    callback add-source();
    callback remove-source(int);
    callback rescan-source(int);
    background: #1e1e1e;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        alignment: start;
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: @tr("Sources");
                color: white;
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
                accessible-role: text;
            }
            Rectangle { }
            Button {
                text: @tr("Add a source…");
                primary: true;
                enabled: !root.busy;
                clicked => { root.add-source(); }
            }
        }
        Text {
            text: @tr("A source is a folder whose photos are in the catalogue. Adding one copies nothing: the photos stay where they are.");
            color: #aaaaaa;
            wrap: word-wrap;
        }
        if root.sources.length == 0 : Text {
            text: @tr("No source yet. Add the folder your photos are in.");
            color: #e0b050;
            wrap: word-wrap;
            accessible-role: text;
        }
        if root.busy : ProgressIndicator {
            progress: root.progress;
        }
        if root.status != "" : Text {
            text: root.status;
            color: #99cc99;
            wrap: word-wrap;
            accessible-role: text;
        }
        ListView {
            height: min(root.sources.length * 68px, 560px);
            for source[i] in root.sources : Rectangle {
                height: 64px;
                background: #262626;
                HorizontalLayout {
                    padding: 8px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: source.name; color: white; font-weight: 700; overflow: elide; }
                            if !source.online : Text {
                                text: @tr("Offline");
                                color: #e08070;
                                accessible-role: text;
                            }
                        }
                        Text { text: source.path; color: #999999; overflow: elide; }
                    }
                    Text {
                        text: @tr("{n} photo" | "{n} photos" % source.photos);
                        color: #cccccc;
                        vertical-alignment: center;
                        accessible-role: text;
                    }
                    Button {
                        text: @tr("Rescan");
                        accessible-label: @tr("Rescan: {}", source.name);
                        enabled: !root.busy && source.online;
                        clicked => { root.rescan-source(i); }
                    }
                    Button {
                        text: @tr("Remove");
                        accessible-label: @tr("Remove: {}", source.name);
                        enabled: !root.busy;
                        clicked => { root.remove-source(i); }
                    }
                }
            }
        }
    }
}
