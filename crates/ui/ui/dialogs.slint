import { Button } from "std-widgets.slint";
import { Field } from "common.slint";

// A dialog over the window: a dimmed background that swallows clicks, and a card. Escape closes it.
export component Modal inherits Rectangle {
    in property <string> title;
    in property <length> card-width: 640px;
    callback close();
    background: #000000b0;
    TouchArea { }
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                return accept;
            }
            reject
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 60px;
            width: min(root.card-width, root.width - 32px);
            height: content.preferred-height;
            background: #2b2b2b;
            border-color: #4a4a4a;
            border-width: 1px;
            border-radius: 6px;
            content := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: root.title;
                    color: white;
                    font-size: 16px;
                    font-weight: 700;
                    accessible-role: text;
                }
                @children
            }
        }
    }
}

export component NewWorkspaceDialog inherits Modal {
    in property <string> error;
    in property <bool> browse-enabled: true;
    in-out property <string> name;
    in-out property <string> location;
    callback create();
    callback browse();
    callback name-edited(string);
    title: @tr("New workspace");
    Field {
        label-width: 110px;
        label: @tr("Name");
        text <=> root.name;
        edited(text) => { root.name-edited(text); }
    }
    Field {
        label-width: 110px;
        label: @tr("Folder");
        text <=> root.location;
        browsable: true;
        browse-enabled: root.browse-enabled;
        browse => { root.browse(); }
    }
    if root.error != "" : Text {
        text: root.error;
        color: #e08070;
        wrap: word-wrap;
        accessible-role: text;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        Button { text: @tr("Cancel"); clicked => { root.close(); } }
        Button { text: @tr("Create"); primary: true; clicked => { root.create(); } }
    }
}

export component SettingsDialog inherits Modal {
    // "system", "en" or "fr".
    in property <string> language;
    callback language-chosen(string);
    title: @tr("Settings");
    Text {
        text: @tr("Language");
        color: #cccccc;
        font-weight: 700;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Button { text: @tr("System"); primary: root.language == "system"; clicked => { root.language-chosen("system"); } }
        Button { text: "English"; primary: root.language == "en"; clicked => { root.language-chosen("en"); } }
        Button { text: "Français"; primary: root.language == "fr"; clicked => { root.language-chosen("fr"); } }
    }
    HorizontalLayout {
        alignment: end;
        Button { text: @tr("Close"); clicked => { root.close(); } }
    }
}

export component AboutDialog inherits Modal {
    in property <string> version;
    title: @tr("About Auroraw");
    card-width: 480px;
    Text { text: @tr("Auroraw {}", root.version); color: white; font-size: 18px; }
    Text {
        text: @tr("A free application for photographers: organise photos, develop RAW files and deliver galleries.");
        color: #cccccc;
        wrap: word-wrap;
    }
    Text { text: @tr("Free software, GNU General Public License 3.0 or later."); color: #aaaaaa; wrap: word-wrap; }
    Text { text: @tr("Made with Slint."); color: #aaaaaa; }
    Text { text: "https://auroraw.org"; color: #7fb0e0; }
    HorizontalLayout {
        alignment: end;
        Button { text: @tr("Close"); primary: true; clicked => { root.close(); } }
    }
}
