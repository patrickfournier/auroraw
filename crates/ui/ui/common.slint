import { Button, LineEdit } from "std-widgets.slint";

export struct Cell {
    photo-id: string,
    thumb: image,
    rating: int,
    ready: bool,
    unavailable: bool,
    selected: bool,
}
export struct GridRow { cells: [Cell] }

// A removable volume offered on the import view (a card or a drive).
export struct VolumeEntry { label: string, path: string }

// Every sentence the Rust side builds at run time goes through here, so it is translated like the
// rest (`@tr()` only works in a .slint file).
export global Texts {
    public pure function default-name() -> string {
        return @tr("Auroraw");
    }
    public pure function photos(n: int) -> string {
        return @tr("{n} photo" | "{n} photos" % n);
    }
    public pure function importing(done: int, total: int) -> string {
        return @tr("Importing {} of {}…", done, total);
    }
    public pure function all-copied(n: int) -> string {
        return @tr("All {n} file copied and verified." | "All {n} files copied and verified." % n);
    }
    public pure function import-summary(copied: int, skipped: int, failed: int) -> string {
        return @tr("{} copied, {} already in the library, {} failed. Run it again to retry.", copied, skipped, failed);
    }
    public pure function import-stopped(reason: string) -> string {
        return @tr("The import stopped: {}", reason);
    }
    public pure function import-refused(reason: string) -> string {
        return @tr("Cannot start the import: {}", reason);
    }
    public pure function import-cancelled() -> string {
        return @tr("Import cancelled. Running it again resumes where it stopped.");
    }
    public pure function reading-card() -> string {
        return @tr("Reading the card…");
    }
    public pure function last-not-found(path: string) -> string {
        return @tr("The last workspace could not be found: {}", path);
    }
    public pure function cannot-open(reason: string) -> string {
        return @tr("Cannot open the workspace: {}", reason);
    }
    public pure function cannot-create(reason: string) -> string {
        return @tr("Cannot create the workspace: {}", reason);
    }
    public pure function default-workspace-name() -> string {
        return @tr("Main");
    }
    public pure function name-required() -> string {
        return @tr("Give the workspace a name.");
    }
    public pure function rebuilt-note(name: string) -> string {
        return @tr("The catalogue of \"{}\" was rebuilt from its files on this machine.", name);
    }
    public pure function indexing(done: int, total: int) -> string {
        return @tr("Reading photos: {} of {}…", done, total);
    }
    public pure function index-done(added: int, restored: int, known: int, failed: int) -> string {
        return @tr("Done: {} added, {} restored, {} already known, {} not readable.", added, restored, known, failed);
    }
    public pure function index-stopped(reason: string) -> string {
        return @tr("The scan stopped: {}", reason);
    }
    public pure function source-removed(name: string, removed: int) -> string {
        return @tr("Source \"{}\" removed; {} photos left the catalogue.", name, removed);
    }
    public pure function merge-question(names: string) -> string {
        return @tr("This folder contains the sources {}. Merge them into the new one? Their photos are kept, with their ratings and versions.", names);
    }
    public pure function scan-cancelled() -> string {
        return @tr("Scan cancelled. Rescanning the source picks up where it stopped.");
    }
    public pure function cannot-add-source(reason: string) -> string {
        return @tr("Cannot add the source: {}", reason);
    }
    // The title of the folder dialog: `which` is "source", "archive" or "backup".
    public pure function pick-title(which: string) -> string {
        if (which == "source") {
            return @tr("Choose the card or folder to import from");
        }
        if (which == "archive") {
            return @tr("Choose the archive folder");
        }
        if (which == "backup") {
            return @tr("Choose the backup folder");
        }
        if (which == "workspace") {
            return @tr("Choose the workspace folder");
        }
        if (which == "add-source") {
            return @tr("Choose the folder to add to the catalogue");
        }
        return @tr("Choose the folder");
    }
}

// What the Edit menu needs to know: whether a text field has the keyboard, so Cut, Copy, Paste and
// the others have something to act on.
export global Editing {
    in-out property <bool> text-focused: false;
}

// One item of the hamburger menu (its id is a command of `commands.rs`).
export struct MenuEntry { id: string, label: string, shortcut: string, enabled: bool }

// One source of the catalogue, as the catalogue panel lists it.
export struct SourceEntry { name: string, path: string, online: bool, photos: int, worked-on: int }

// One line of the welcome list: a workspace this machine knows.
export struct KnownEntry { name: string, path: string, opened: string, found: bool }

export component Task inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> enabled: true;
    callback activate();
    width: 120px;
    height: 36px;
    background: active ? #3a5f8a : #2b2b2b;
    TouchArea {
        clicked => { if (enabled) { root.activate(); } }
    }
    Text {
        text: root.label;
        color: root.enabled ? (root.active ? white : #cccccc) : #666666;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        accessible-role: tab;
        accessible-label: root.label;
    }
}

export component Field inherits HorizontalLayout {
    in property <string> label;
    in property <string> placeholder;
    // A folder field offers a button that opens the system's folder dialog.
    in property <length> label-width: 300px;
    in property <bool> browsable: false;
    in property <bool> browse-enabled: true;
    in-out property <string> text;
    callback browse();
    callback edited(string);
    spacing: 8px;
    Text {
        text: root.label;
        width: root.label-width;
        color: #cccccc;
        vertical-alignment: center;
    }
    LineEdit {
        text <=> root.text;
        placeholder-text: root.placeholder;
        accessible-label: root.label;
        edited(text) => { root.edited(text); }
        changed has-focus => { Editing.text-focused = self.has-focus; }
    }
    // Every field ends at the same place, with or without a button.
    if !root.browsable : Rectangle { width: 100px; }
    if root.browsable : Button {
        width: 100px;
        text: @tr("Browse…");
        enabled: root.browse-enabled;
        accessible-label: @tr("Browse for: {}", root.label);
        clicked => { root.browse(); }
    }
}
