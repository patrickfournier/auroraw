import { ListView, Button } from "std-widgets.slint";

export struct Cell { thumb: image, rating: int, ready: bool }
export struct GridRow { cells: [Cell] }

export component GridWindow inherits Window {
    width: 1500px;
    height: 900px;
    background: #1e1e1e;
    title: "Auroraw spike 3: the catalogue";
    in property <[GridRow]> rows;
    in property <string> stats;
    in-out property <length> scroll: 0px;
    callback filter(int);

    Rectangle {
        x: 0; y: 0; width: root.width; height: 36px; background: #2b2b2b;
        Button { x: 6px; y: 4px; height: 28px; text: "All"; clicked => { root.filter(0); } }
        Button { x: 80px; y: 4px; height: 28px; text: "Rating 4+"; clicked => { root.filter(1); } }
        Button { x: 190px; y: 4px; height: 28px; text: "Keyword group"; clicked => { root.filter(2); } }
        Button { x: 340px; y: 4px; height: 28px; text: "Keyword category"; clicked => { root.filter(3); } }
        Text { x: 520px; y: 0; height: 36px; text: root.stats; color: #99cc99; vertical-alignment: center; }
    }
    ListView {
        x: 0; y: 36px; width: root.width; height: root.height - 36px;
        content-y <=> root.scroll;
        for row in root.rows : HorizontalLayout {
            height: 124px; spacing: 4px; alignment: start;
            for c in row.cells : Rectangle {
                width: 180px; height: 120px; background: #333333;
                if c.ready : Image { source: c.thumb; width: 180px; height: 120px; image-fit: cover; }
                if c.rating > 0 : Text { x: 6px; y: 4px; text: "\{c.rating}★"; color: #ffd24a; }
            }
        }
    }
}
